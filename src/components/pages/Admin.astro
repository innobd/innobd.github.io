---
import Base from '@/layouts/Base.astro';
import { type Lang } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
---
<Base lang={lang} current="admin" title={ko ? '홈페이지 관리' : 'Website editor'}>
  <section class="section"><div class="wrap">
    <p class="eyebrow">WEBSITE EDITOR</p>
    <h1>{ko ? '글과 사진을 바꾸는 곳' : 'Keep the lab up to date.'}</h1>
    <p class="lead" style="margin-top:24px">{ko ? '아래 편집기에 로그인한 뒤, 수정할 항목을 선택하세요.' : 'Sign in to the editor and choose the content you want to update.'}</p>
    <p style="margin-top:28px"><a class="btn" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">{ko ? '편집기 열기 ↗' : 'Open editor ↗'}</a></p>
    <div class="editor-note">{ko ? '처음 한 번은 GitHub 계정으로 로그인하고 이 홈페이지 저장소에 Pages CMS를 연결해야 합니다. 편집 권한이 있는 계정만 저장할 수 있습니다.' : 'First, sign in with GitHub and connect Pages CMS to this website’s repository. Saving requires editor access.'}</div>
    <ol class="editor-steps">
      <li>{ko ? '소식 · 구성원 · 논문 · 연구 주제 · 연구실 기본정보 · 모집 안내 중에서 선택합니다.' : 'Choose News, People, Publications, Research, Lab information or Join.'}</li>
      <li>{ko ? '한국어·영어 입력란에 내용을 적고, 사진 칸에서 이미지를 올립니다. 자동 번역은 연결되어 있지 않습니다.' : 'Edit the Korean and English fields and upload images. Automatic translation is not connected.'}</li>
      <li>{ko ? '저장하면 홈페이지 갱신이 시작됩니다. 반영까지 최대 10분 정도 걸릴 수 있습니다.' : 'Save to start the website update. Publishing may take up to 10 minutes.'}</li>
      <li>{ko ? '홈페이지로 돌아와 새로고침하고, 한국어·영어 화면을 확인합니다.' : 'Refresh the website and check both languages.'}</li>
    </ol>
    <p class="muted">{ko ? '글·사진을 입력하는 폼 방식입니다. Google Sites처럼 화면 배치를 끌어서 바꾸는 편집기는 아닙니다.' : 'This editor uses content forms. Page layout is maintained separately.'}</p>
  </div></section>
</Base>
