---
import Base from '@/layouts/Base.astro';
import research from '@/data/research.json';
import collaborators from '@/data/collaborators.json';
import { t, pick, asset, type Lang } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
---
<Base lang={lang} current="research" title={tr('research.title')}>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><h1 style="font-size:clamp(2rem,4vw,3rem)">{tr('research.title')}</h1><p class="lead">{tr('research.lead')}</p></div></div>
      <div class="research-legend">
        <span><i></i>{tr('research.track.platform')}</span>
        <span><i class="method"></i>{tr('research.track.method')}</span>
      </div>
      <ul class="research-list">
        {research.map((r) => (
          <li id={r.id}>
            <h3><span class={`swatch ${r.track}`}></span>{pick(lang, r.title)}</h3>
            <div>
              <p>{pick(lang, r.summary)}</p>
              {r.keywords?.length > 0 && <p class="kw">{r.keywords.join(', ')}</p>}
              {r.images?.length > 0 && (
                <ul class="research-photos">
                  {r.images.map((img: any) => (
                    <li>
                      <figure>
                        <img src={asset(img.image)} alt={pick(lang, img.caption) || pick(lang, r.title)} loading="lazy" />
                        {(img.caption?.en || img.caption?.ko) && <figcaption>{pick(lang, img.caption)}</figcaption>}
                      </figure>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
      {collaborators.length > 0 && (
        <div class="pi-section">
          <h2>{tr('research.collaborators')}</h2>
          <ul class="collab-grid">
            {collaborators.map((c: any) => (
              <li class="collab-card">
                <h3>{pick(lang, c.institution)}</h3>
                <p class="muted small">{pick(lang, c.country)}</p>
                {c.people && <p class="collab-people">{c.people}</p>}
                {(c.note?.en || c.note?.ko) && <p>{pick(lang, c.note)}</p>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>
