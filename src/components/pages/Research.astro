---
import Base from '@/layouts/Base.astro';
import research from '@/data/research.json';
import collaborators from '@/data/collaborators.json';
import { t, pick, type Lang } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const { why, questions, approach, references } = research as any;
const refList = (ids: string[] = []) => ids.map((id) => (references as any[]).find((r) => r.id === id)).filter(Boolean);
const relatedLabel = lang === 'ko' ? '관련 연구' : 'Related work';
---
<Base lang={lang} current="research" title={tr('research.title')}>
  <section class="section">
    <div class="wrap">
      <h1 style="font-size:clamp(2rem,4vw,3rem);margin-bottom:40px">{tr('research.title')}</h1>

      <div class="rs-block">
        <h2 class="rs-h2">{why.title}</h2>
        <p class="rs-sub">{pick(lang, why.subtitle)}</p>
        <div class="rs-body">
          {why.paragraphs.map((p: any) => <p>{pick(lang, p)}</p>)}
        </div>
      </div>

      <div class="rs-block">
        <h2 class="rs-h2">{questions.title}</h2>
        <ol class="rs-questions">
          {questions.items.map((q: any, i: number) => (
            <li id={q.id}>
              <span class="rs-num">{i + 1}</span>
              <div>
                <h3>{pick(lang, q.q)}</h3>
                <div class="rs-body">
                  {q.paragraphs.map((p: any) => <p>{pick(lang, p)}</p>)}
                </div>
                <p class="rs-take">{pick(lang, q.takeaway)}</p>
                {refList(q.refs).length > 0 && (
                  <div class="rs-refs">
                    <span class="rs-refs-label">{relatedLabel}</span>
                    <ul>
                      {refList(q.refs).map((r: any) => (
                        <li>
                          <a href={`https://doi.org/${r.doi}`} target="_blank" rel="noopener">{r.title}</a>
                          <span class="rs-ref-meta"> {r.journal} {r.year}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="rs-block">
        <h2 class="rs-h2">{approach.title}</h2>
        <p class="rs-sub">{pick(lang, approach.subtitle)}</p>
        <div class="rs-body"><p>{pick(lang, approach.intro)}</p></div>
        <ul class="rs-approach">
          {approach.items.map((it: any, i: number) => (
            <li>
              <span class="rs-num">{i + 1}</span>
              <div>
                <h3>{pick(lang, it.title)}</h3>
                <p>{pick(lang, it.body)}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="rs-closing">
          <h3>{pick(lang, approach.closing.title)}</h3>
          <div class="rs-body">
            {approach.closing.paragraphs.map((p: any) => <p>{pick(lang, p)}</p>)}
          </div>
          <p class="rs-final">{pick(lang, approach.closing.final)}</p>
        </div>
      </div>

      {collaborators.length > 0 && (
        <div class="pi-section">
          <h2>{tr('research.collaborators')}</h2>
          <ul class="collab-grid">
            {collaborators.map((c: any) => (
              <li class="collab-card">
                <h3>{pick(lang, c.institution)}</h3>
                <p class="muted small">{pick(lang, c.country)}</p>
                {c.people && <p class="collab-people">{c.people}</p>}
                {(c.note?.en || c.note?.ko) && <p>{pick(lang, c.note)}</p>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>
