---
import Base from '@/layouts/Base.astro';
import PersonCard from '@/components/PersonCard.astro';
import members from '@/data/members.json';
import { t, type Lang } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
// active groups, shown at the top level
const groups = ['postdoc', 'phd', 'ms', 'undergrad'] as const;
// "former members" groups, nested under one shared heading
const formerGroups = ['alumni', 'intern'] as const;
const hasFormerMembers = formerGroups.some((g) => members.some((m) => m.role === g));
---
<Base lang={lang} current="team" title={tr('team.title')}>
  <section class="section">
    <div class="wrap">
      <h1 style="font-size:clamp(2rem,4vw,3rem);margin-bottom:40px">{tr('team.title')}</h1>
      {groups.map((g) => {
        const list = members.filter((m) => m.role === g);
        if (!list.length) return null;
        return (
          <div class="people-group">
            <h2>{tr(`team.${g}` as any)}</h2>
            <div class="people-grid">
              {list.map((m) => (
                <PersonCard lang={lang} member={m} />
              ))}
            </div>
          </div>
        );
      })}
      {hasFormerMembers && (
        <div class="people-group">
          <h2>{tr('team.former')}</h2>
          <div class="people-subgroups">
            {formerGroups.map((g) => {
              const list = members.filter((m) => m.role === g);
              if (!list.length) return null;
              return (
                <div class="people-subgroup">
                  <h3>{tr(`team.${g}` as any)}</h3>
                  <div class="people-grid">
                    {list.map((m) => (
                      <PersonCard lang={lang} member={m} />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
