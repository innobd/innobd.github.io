---
import Base from '@/layouts/Base.astro';
import Particle from '@/components/Particle.astro';
import HomeCarousel from '@/components/HomeCarousel.astro';
import NewsList from '@/components/NewsList.astro';
import lab from '@/data/lab.json';
import news from '@/data/news.json';
import { t, pick, href, type Lang } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const thisYear = new Date().getFullYear();
const currentYearNews = news
  .filter((n: any) => new Date(n.date).getFullYear() === thisYear)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<Base lang={lang} current="home">
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Innovative Biopharmaceutical Delivery Lab.</p>
        <h1>{pick(lang, lab.hero.headline)}</h1>
        <div class="actions">
          <a class="btn" href={href(lang, '/research')}>{tr('home.explore')}</a>
          <a class="btn ghost" href={href(lang, '/join')}>{tr('home.openings')}</a>
        </div>
        <p class="affil">{pick(lang, lab.name)}<br />{pick(lang, lab.affiliation)}</p>
      </div>
      <Particle />
    </div>
  </section>

  <HomeCarousel lang={lang} />

  {currentYearNews.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div><p class="eyebrow">01 / NEWS</p><h2>{thisYear}{lang === 'ko' ? '년 소식' : ' News'}</h2></div>
          <a href={href(lang, '/news')}>{tr('home.seeAll')}</a>
        </div>
        <NewsList lang={lang} items={currentYearNews} />
      </div>
    </section>
  )}
</Base>
