---
// Hero animation (about 10 s loop). A lipid nanoparticle (LNP) docks on a cell,
// a near-infrared beam (translucent red) hits the contact point, an orange
// ripple opens the membrane for a moment (photoporation), the mRNA slips in,
// the membrane closes, and the cell makes protein: two inside the cell and two
// on the outer face of the membrane (green). Reduced-motion visitors get the
// final still frame.
---
<svg class="delivery" viewBox="0 0 400 400" role="img" aria-label="Animation: a lipid nanoparticle docks on a cell, a near-infrared light beam opens the membrane briefly, mRNA enters, and the cell makes protein inside and on its surface. 지질나노입자가 세포막에 닿고, 근적외선 빛으로 세포막이 잠시 열려 mRNA가 들어간 뒤 세포 안과 세포막 바깥쪽에 단백질이 만들어지는 과정">
  <defs>
    <linearGradient id="nir-grad" gradientUnits="userSpaceOnUse" x1="40" y1="5" x2="124" y2="198">
      <stop offset="0" stop-color="#d8333b" stop-opacity="0" />
      <stop offset="1" stop-color="#d8333b" stop-opacity="0.6" />
    </linearGradient>
  </defs>
  <!-- cell -->
  <circle cx="250" cy="200" r="125" fill="var(--lipid-soft)" opacity="0.6" />
  <path d="M132.54 157.25 A125 125 0 1 1 132.54 242.75" fill="none" stroke="var(--lipid)" stroke-width="6" stroke-linecap="round" />
  <path class="patch" d="M132.54 242.75 A125 125 0 0 1 132.54 157.25" fill="none" stroke="var(--lipid)" stroke-width="6" stroke-linecap="round" />
  <!-- near-infrared beam, straight from the upper left to the contact point -->
  <g class="beam">
    <line x1="40" y1="5" x2="124" y2="198" pathLength="100" stroke="url(#nir-grad)" stroke-width="22" stroke-linecap="round" opacity="0.35" />
    <line x1="40" y1="5" x2="124" y2="198" pathLength="100" stroke="url(#nir-grad)" stroke-width="8" stroke-linecap="round" />
  </g>
  <!-- orange ripples at the contact point -->
  <circle class="pulse" cx="124" cy="200" r="14" fill="none" stroke="var(--orange)" stroke-width="3" />
  <circle class="pulse pulse2" cx="124" cy="200" r="14" fill="none" stroke="var(--orange)" stroke-width="2" />
  <!-- proteins: two inside the cell, two facing outward on the membrane -->
  <g class="prots">
    <g class="prot p1"><circle cx="214" cy="238" r="10" fill="var(--green)" /></g>
    <g class="prot p2"><circle cx="270" cy="252" r="10" fill="var(--green)" /></g>
    <g class="prot p3"><line x1="348.1" y1="117.7" x2="355.7" y2="111.3" stroke="var(--green)" stroke-width="3" stroke-linecap="round" /><circle cx="362.6" cy="105.5" r="9" fill="var(--green)" /></g>
    <g class="prot p4"><line x1="354.9" y1="273.4" x2="363.0" y2="279.2" stroke="var(--green)" stroke-width="3" stroke-linecap="round" /><circle cx="370.4" cy="284.3" r="9" fill="var(--green)" /></g>
  </g>
  <!-- mRNA strand: leaves the LNP, enters the cell -->
  <g transform="translate(97 200)">
    <g class="mrna">
      <path d="M-45 0 C-35 -18 -25 18 -15 0 S5 -18 15 0 S35 18 45 0" fill="none" stroke="var(--payload)" stroke-width="5" stroke-linecap="round" />
    </g>
  </g>
  <!-- LNP -->
  <g transform="translate(97 200)">
    <g class="lnp">
      <circle r="24" fill="#fff" opacity="0.85" stroke="var(--lipid)" stroke-width="3" />
      <circle cx="24.00" cy="0.00" r="3.8" fill="var(--lipid)" /><circle cx="20.78" cy="12.00" r="3.8" fill="var(--lipid)" /><circle cx="12.00" cy="20.78" r="3.8" fill="var(--lipid)" /><circle cx="0.00" cy="24.00" r="3.8" fill="var(--lipid)" /><circle cx="-12.00" cy="20.78" r="3.8" fill="var(--lipid)" /><circle cx="-20.78" cy="12.00" r="3.8" fill="var(--lipid)" /><circle cx="-24.00" cy="0.00" r="3.8" fill="var(--lipid)" /><circle cx="-20.78" cy="-12.00" r="3.8" fill="var(--lipid)" /><circle cx="-12.00" cy="-20.78" r="3.8" fill="var(--lipid)" /><circle cx="-0.00" cy="-24.00" r="3.8" fill="var(--lipid)" /><circle cx="12.00" cy="-20.78" r="3.8" fill="var(--lipid)" /><circle cx="20.78" cy="-12.00" r="3.8" fill="var(--lipid)" />
      <path d="M-12 0 C-8 -8 -4 8 0 0 S8 -8 12 0" fill="none" stroke="var(--payload)" stroke-width="2.5" stroke-linecap="round" />
    </g>
  </g>
</svg>
