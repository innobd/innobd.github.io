---
import { t, pick, asset, formatDate, type Lang } from '@/i18n/ui';
const { lang, items } = Astro.props as { lang: Lang; items: any[] };
const tr = t(lang);
/** Deterministic 1-4 pick from a string, so a placeholder thumbnail stays the same across rebuilds. */
function variant(seed: string): number {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
  return (h % 4) + 1;
}
---
<ul class="ra-list">
  {items.map((n) => (
    <li class="ra-item" id={n.id}>
      <div class="ra-meta">
        <span class={`ra-type type-${n.type}`}>{tr(`news.type.${n.type}` as any)}</span>
        <time class="ra-date" datetime={n.date}>{n.datePrecision === 'year' ? n.date.slice(0, 4) : formatDate(lang, n.date)}</time>
      </div>
      <div class="ra-body">
        <h3 class="ra-title">{n.link ? <a href={n.link}>{pick(lang, n.text)}</a> : pick(lang, n.text)}</h3>
      </div>
      {n.image
        ? <img class="ra-thumb" src={asset(n.image)} alt="" loading="lazy" />
        : <div class={`ra-thumb ra-thumb-ph ra-thumb-ph-${variant(n.id || n.text?.en || n.date)}`} aria-hidden="true"></div>}
    </li>
  ))}
</ul>
